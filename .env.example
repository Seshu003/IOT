# Backend
NODE_ENV=development
API_TOKEN=demo-token
PORT=5000
CORS_ORIGIN=http://localhost:3000
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# Set both values to require MQTT client authentication.
# MQTT_USERNAME=iot-service
# MQTT_PASSWORD=change-me

# Optional PostgreSQL connection
# PG_DATABASE_URL=postgres://postgres:postgres@localhost:5432/iot_db
