# Must match backend API_TOKEN. The development default is demo-token.
VITE_API_TOKEN=demo-token

# For Vercel, point these to the separately hosted backend service.
# Example: https://bharat-iot-api.example.com/api
# VITE_API_URL=https://your-backend-host.example.com/api
# VITE_SOCKET_URL=https://your-backend-host.example.com
